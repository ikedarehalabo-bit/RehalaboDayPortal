# Supabase（Dashboard → Settings → API から取得し、実値を .env.local に入れる）
# .env.local は git に載せない（.gitignore 済み）。service_role は秘匿。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps（送迎ルート生成：Geocoding API + Routes API を有効化したキー）
# ※ 旧ポータルと同じGCPキー可。要ローテーション（露出済みの旧キーは更新）。
GOOGLE_MAPS_API_KEY=

# 職員認証：ポータル(Workプラットフォーム)のSupabase認証に相乗り（下記2つは公開可能キー）
NEXT_PUBLIC_PORTAL_SUPABASE_URL=https://iaiomjjqzecbgeoqsicw.supabase.co
NEXT_PUBLIC_PORTAL_SUPABASE_ANON_KEY=sb_publishable_lOxDknfoaukRc1dy94yDaw_RRJO7fLw
# セッションCookie署名鍵（必須・秘匿）。生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
