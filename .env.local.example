# Supabase（Dashboard → Settings → API から取得し、実値を .env.local に入れる）
# .env.local は git に載せない（.gitignore 済み）。service_role は秘匿。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps（送迎ルート生成：Geocoding API + Routes API を有効化したキー）
# ※ 旧ポータルと同じGCPキー可。要ローテーション（露出済みの旧キーは更新）。
GOOGLE_MAPS_API_KEY=

# 職員認証：ポータル(Workプラットフォーム)と同じ Firebase 認証に相乗り
# 下記は「公開設定」（クライアントに埋まる値・秘密ではない）。
# ポータルの Vercel → Settings → Environment Variables から下記2つをコピー：
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# セッションCookie署名鍵（必須・秘匿）。生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 乗降通知のWeb Push（任意・家族ポータル導入時に有効化）。生成: npx web-push generate-vapid-keys
# 未設定でも乗降記録は動く（送信のみスキップ）。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rehalabo.net
